    "still": "remotion still src/index.ts MaryamFilm out/still.png",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.536",
    "@remotion/player": "4.0.536",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.536"
  },
  "devDependencies": {
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "typescript": "5.9.2",
    "vite": "7.1.9"
  }
}
